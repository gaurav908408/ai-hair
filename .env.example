# AI Hair Generator Provider Configuration
AILABAPI_API_KEY=your_ailabapi_api_key_here
AILAB_HAIRSTYLE_ENDPOINT=https://www.ailabapi.com/api/portrait/effects/hairstyle-editor-pro
# Optional OpenAI fallback provider
OPENAI_API_KEY=your_openai_api_key_here

# Daily Credit Management Configuration (Production SQLite)
# Fixed number of free hairstyle generations per user per day
DAILY_CREDIT_LIMIT=5

# Timezone used to calculate server-side midnight resets (e.g., Asia/Kolkata, UTC, America/New_York)
RESET_TIMEZONE=Asia/Kolkata

# Persistent database storage path for credit accounts and audit ledger
CREDIT_DB_PATH=data/credits.db

# Cryptographic HMAC-SHA256 secret key for signing HttpOnly session cookies
CREDIT_SECRET_KEY=bhg_production_secure_secret_key_change_me

# Legacy Rate Limit Compatibility
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_DB_PATH=data/credits.db
